# Copy this file to .env and fill in real values. Never commit the real .env.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if you test github_client.py functions directly against a live repo/PR
# from your own machine (a personal access token with repo/PR permissions).
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPOSITORY=your-username/your-repo
